# Copy file này thành .env rồi điền giá trị (KHÔNG commit .env)

PORT=3000

# --- MQTT (phải khớp TOPIC_PREFIX trong firmware ESP32) ---
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_PREFIX=aqua/lq-7f3a

# --- Firebase ---
FIREBASE_DATABASE_URL=https://<ten-project>-default-rtdb.asia-southeast1.firebasedatabase.app
# Cách 1 (local): đường dẫn file service account JSON tải từ Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Cách 2 (Render): dán NGUYÊN nội dung file JSON vào 1 dòng (bỏ qua nếu dùng cách 1)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Tuỳ chọn ---
HISTORY_INTERVAL_SEC=60
ALERT_COOLDOWN_MIN=10
TIMEZONE=Asia/Ho_Chi_Minh
